{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.aurakids.fun"
        }
      ],
      "destination": "https://aurakids.fun/",
      "statusCode": 308,
      "regex": "^(?!/_next)/(?:/)?$"
    },
    {
      "source": "/:path((?!api/|\\.well-known/).+)",
      "has": [
        {
          "type": "host",
          "value": "www.aurakids.fun"
        }
      ],
      "destination": "https://aurakids.fun/:path",
      "statusCode": 308,
      "regex": "^(?!/_next)(?:/((?!api/|\\.well-known/).+))(?:/)?$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [
      {
        "source": "/apple-touch-icon.png",
        "destination": "/api/icon?size=180&app=both",
        "regex": "^/apple-touch-icon\\.png(?:/)?$"
      },
      {
        "source": "/apple-touch-icon-precomposed.png",
        "destination": "/api/icon?size=180&app=both",
