inejoin=\"round\" aria-hidden=\"true\"><circle cx=\"18\" cy=\"5\" r=\"3\"></circle><circle cx=\"6\" cy=\"12\" r=\"3\"></circle><circle cx=\"18\" cy=\"19\" r=\"3\"></circle><path d=\"M8.6 13.5l6.8 4M15.4 6.5l-6.8 4\"></path></svg></button><div class=\"lang-dd\"><button class=\"lang-trigger\" aria-label=\"Език\"><span style=\"font-size:19px\">🇧🇬</span><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"transform:none;transition:transform .2s\"><path d=\"M6 9l6 6 6-6\"></path></svg></button></div></div></div><div class=\"portal-body\"><h1 class=\"hero-h1 portal-h1\" data-rise=\"true\" style=\"animation-delay:.1s\">Само едно дете<!-- --> <!-- -->е героят.<!-- --> <span class=\"shimmer\">Твоето.</span></h1><p class=\"hero-sub\" data-rise=\"true\" style=\"animation-delay:.18s\">Избери какво приключение да създадем тази вечер.</p><div class=\"portal-doors\" data-rise=\"true\" style=\"animation-delay:.26s\"><button class=\"portal-door\"><div class=\"portal-door-img pos-bottom\"><div class=\"door-img\"><img alt=\"\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"https://cdthqixswrcxkyodzdjp.supabase.co/storage/v1/object/public/story-images/door-story-card.png\"/></div><span class=\"portal-fade\"></span></div><div class=\"portal-door-foot\"><div style=\"min-width:0\"><span class=\"door-title\">Вечерна приказка</span><span class=\"door-desc\" style=\"display:block\">Нежна история за сладки сънища</span></div><span class=\"portal-arrow\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14M13 6l6 6-6 6\"></path></svg></span></div></button><button class=\"portal-door\"><div class=\"portal-door-img pos-top\"><div class=\"door-img\"><img alt=\"\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"https://cdthqixswrcxkyodzdjp.supabase.co/storage/v1/object/public/story-images/door-comic.png\"/></div><span class=\"portal-fade\"></span></div><div class=\"portal-door-foot\"><div style=\"min-width:0\"><span class=\"door-title\">Комикс студио</span><span class=\"door-desc\" style=\"display:block\">Екшън комикс с твоя малък герой</span></div><span class=\"portal-arrow\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14M13 6l6 6-6 6\"></path></svg></span></div></button></div></div></div></section><section class=\"py-20 px-6\" style=\"background:linear-gradient(180deg, #FFF8F0 0%, #F0E6FF 60%, #FFF8F0 100%)\"><div class=\"max-w-5xl mx-auto\"><div class=\"text-center mb-16\"><p class=\"text-sm font-semibold uppercase tracking-widest mb-3\" style=\"color:#9B6FE8\">Как работи</p><h2 class=\"text-4xl md:text-5xl font-bold leading-tight\" style=\"color:#1A0533\">Четири стъпки до<br/><span style=\"color:#6B35B8\">вечер, която не се забравя</span></h2></div><div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5\"><div class=\"relative group\"><div class=\"hidden lg:block absolute -right-3.5 top-20 z-20 text-2xl select-none\" style=\"color:#C4B5FD\">›</div><div class=\"h-full rounded-3xl overflow-hidden bg-white transition-transform duration-300 group-hover:-translate-y-1\" style=\"box-shadow:0 8px 32px rgba(107,53,184,0.12), 0 0 0 1px rgba(0,0,0,0.04)\"><div class=\"relative\"><div class=\"relative h-48 w-full overflow-hidden\"><div class=\"absolute inset-0 flex items-center justify-center\" style=\"background:linear-gradient(135deg, #FF6B6B 0%, #FF8E53 100%)\"><svg class=\"animate-spin w-6 h-6 text-white/60\" viewBox=\"0 0 24 24\" fill=\"none\"><circle class=\"opacity-25\" cx=\"12\" cy=\"12\" r=\"10\" stroke=\"currentColor\" stroke-width=\"4\"></circle><path class=\"opacity-75\" fill=\"currentColor\" d=\"M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z\"></path></svg></div><div class=\"absolute bottom-0 left-0 right-0 h-14 pointer-events-none\" style=\"background:linear-gradient(to bottom, transparent, white)\"></div></div><div class=\"absolute top-3 left-3 w-7 h-7 rounded-full flex items-center justify-center text-xs font-black z-10\" style=\"background:rgba(0,0,0,0.28);color:white;backdrop-filter:blur(6px)\">1</div></div><div class=\"px-5 pt-1 pb-5\"><h3 class=\"text-sm font-bold mb-1\" style=\"color:#1A0533\">Назови героя</h3><p class=\"text-xs leading-relaxed\" style=\"color:#7B6FA0\">Въведи името на детето и на колко години е.</p></div></div></div><div class=\"relative group\"><div class=\"hidden lg:block absolute -right-3.5 top-20 z-20 text-2xl select-none\" style=\"color:#C4B5FD\">›</div><div class=\"h-full rounded-3xl overflow-hidden bg-white transition-transform duration-300 group-hover:-translate-y-1\" style=\"box-shadow:0 8px 32px rgba(107,53,184,0.12), 0 0 0 1px rgba(0,0,0,0.04)\"><div class=\"relative\"><div class=\"relative h-48 w-full overflow-hidden\"><div class=\"absolute inset-0 flex items-center justify-center\" style=\"background:linear-gradient(135deg, #FFD93D 0%, #FF9A3C 100%)\"><svg class=\"animate-spin w-6 h-6 text-white/60\" viewBox=\"0 0 24 24\" fill=\"none\"><circle class=\"opacity-25\" cx=\"12\" cy=\"12\" r=\"10\" stroke=\"currentColor\" stroke-width=\"4\"></circle><path class=\"opacity-75\" fill=\"currentColor\" d=\"M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z\"></path></svg></div><div class=\"absolute bottom-0 left-0 right-0 h-14 pointer-events-none\" style=\"background:linear-gradient(to bottom, transparent, white)\"></div></div><div class=\"absolute top-3 left-3 w-7 h-7 rounded-full flex items-center justify-center text-xs font-black z-10\" style=\"background:rgba(0,0,0,0.28);color:white;backdrop-filter:blur(6px)\">2</div></div><div class=\"px-5 pt-1 pb-5\"><h3 class=\"text-sm font-bold mb-1\" style=\"color:#1A0533\">Избери свят</h3><p class=\"text-xs leading-relaxed\" style=\"color:#7B6FA0\">Дракони, космос, вълшебна гора — или измисли свой.</p></div></div></div><div class=\"relative group\"><div class=\"hidden lg:block absolute -right-3.5 top-20 z-20 text-2xl select-none\" style=\"color:#C4B5FD\">›</div><div class=\"h-full rounded-3xl overflow-hidden bg-white transition-transform duration-300 group-hover:-translate-y-1\" style=\"box-shadow:0 8px 32px rgba(107,53,184,0.12), 0 0 0 1px rgba(0,0,0,0.04)\"><div class=\"relative\"><div class=\"relative h-48 w-full overflow-hidden\"><div class=\"absolute inset-0 flex items-center justify-center\" style=\"background:linear-gradient(135deg, #A78BFA 0%, #6B35B8 100%)\"><svg class=\"animate-spin w-6 h-6 text-white/60\" viewBox=\"0 0 24 24\" fill=\"none\"><circle class=\"opacity-25\" cx=\"12\" cy=\"12\" r=\"10\" stroke=\"currentColor\" stroke-width=\"4\"></circle><path class=\"opacity-75\" fill=\"currentColor\" d=\"M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z\"></path></svg></div><div class=\"absolute bottom-0 left-0 right-0 h-14 pointer-events-none\" style=\"background:linear-gradient(to bottom, transparent, white)\"></div></div><div class=\"absolute top-3 left-3 w-7 h-7 rounded-full flex items-center justify-center text-xs font-black z-10\" style=\"background:rgba(0,0,0,0.28);color:white;backdrop-filter:blur(6px)\">3</div></div><div class=\"px-5 pt-1 pb-5\"><h3 class=\"text-sm font-bold mb-1\" style=\"color:#1A0533\">Приказката се ражда</h3><p class=\"text-xs leading-relaxed\" style=\"color:#7B6FA0\">AI пише история само за вашето дете с уникални илюстрации.</p></div></div></div><div class=\"relative group\"><div class=\"h-full rounded-3xl overflow-hidden bg-white transition-transform duration-300 group-hover:-translate-y-1\" style=\"box-shadow:0 8px 32px rgba(107,53,184,0.12), 0 0 0 1px rgba(0,0,0,0.04)\"><div class=\"relative\"><div class=\"relative h-48 w-full overflow-hidden\"><div class=\"absolute inset-0 flex items-center justify-center\" style=\"background:linear-gradient(135deg, #67E8F9 0%, #2563EB 100%)\"><svg class=\"animate-spin w-6 h-6 text-white/60\" viewBox=\"0 0 24 24\" fill=\"none\"><circle class=\"opacity-25\" cx=\"12\" cy=\"12\" r=\"10\" stroke=\"currentColor\" stroke-width=\"4\"></circle><path class=\"opacity-75\" fill=\"currentColor\" d=\"M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z\"></path></svg></div><div class=\"absolute bottom-0 left-0 right-0 h-14 pointer-events-none\" style=\"background:linear-gradient(to bottom, transparent, white)\"></div></div><div class=\"absolute top-3 left-3 w-7 h-7 rounded-full flex items-center justify-center text-xs font-black z-10\" style=\"background:rgba(0,0,0,0.28);color:white;backdrop-filter:blur(6px)\">4</div></div><div class=\"px-5 pt-1 pb-5\"><h3 class=\"text-sm font-bold mb-1\" style=\"color:#1A0533\">Чуй я на глас</h3><p class=\"text-xs leading-relaxed\" style=\"color:#7B6FA0\">Топъл глас разказва приказката. После я намираш в библиотеката.</p></div></div></div></div></div></section><section class=\"py-28 px-6\" style=\"background:linear-gradient(180deg, #F5EEFF 0%, #EDE0FF 100%)\"><div class=\"max-w-5xl mx-auto\"><div class=\"text-center mb-16\"><p class=\"text-sm font-semibold uppercase tracking-widest mb-4\" style=\"color:#9B6FE8\">Примерни приказки</p><h2 class=\"text-4xl md:text-5xl font-bold leading-tight mb-5\" style=\"color:#1A0533\">Никое друго дете<br/><span style=\"color:#6B35B8\">не е получавало тази история</span></h2><p class=\"text-lg max-w-lg mx-auto\" style=\"color:#6B5A8A;line-height:1.7\">Не шаблон. Не готова приказка. Нова история, написана в момента — само за вашето дете.</p></div><div class=\"grid grid-cols-1 md:grid-cols-3 gap-6 mb-14\"><div class=\"group rounded-3xl overflow-hidden card-hover flex flex-col\" style=\"box-shadow:0 8px 48px #FF6B6B22, 0 2px 8px 