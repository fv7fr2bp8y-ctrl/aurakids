nt\":\"bg_BG\"}],[\"$\",\"meta\",\"12\",{\"property\":\"og:image\",\"content\":\"https://aurakids.fun/og-story.jpg\"}],[\"$\",\"meta\",\"13\",{\"property\":\"og:image:width\",\"content\":\"1200\"}],[\"$\",\"meta\",\"14\",{\"property\":\"og:image:height\",\"content\":\"630\"}],\"$L27\",\"$L28\",\"$L29\",\"$L2a\",\"$L2b\",\"$L2c\",\"$L2d\",\"$L2e\",\"$L2f\",\"$L30\",\"$L31\",\"$L32\"]}]}],null]}],\"$L33\"]}],\"p\":\"$@34\",\"v\":null,\"s\":\"$9\"}},\"a\":\"$@35\",\"u\":\"$@36\",\"b\":\"UXF-L2Hawn6F6Xr7QErwh\"}\n37:I[97367,[\"$2\"],\"OutletBoundary\"]\n39:I[27201,[\"$2\"],\"IconMark\"]\ne:[\"$\",\"li\",null,{\"children\":[[\"$\",\"b\",null,{\"children\":\"Създаденото съдържание\"}],\" (текст, илюстрации, глас) се пази, за да можеш да го отваряш пак. Пази се локално на устройството и в облак, свързан с анонимен „семеен код\\\" — без имейл или акаунт.\"]}]\nf:[\"$\",\"li\",null,{\"children\":[[\"$\",\"b\",null,{\"children\":\"Технически данни\"}],\": стандартни логове на сървъра (напр. при грешка) и общи бройки за посещенията на страниците, без лични данни.\"]}]\n10:[\"$\",\"section\",null,{\"style\":{\"marginBottom\":24},\"children\":[[\"$\",\"h2\",null,{\"style\":{\"fontSize\":18,\"fontWeight\":700,\"color\":\"#fff\",\"marginBottom\":6},\"children\":\"Не събираме излишни лични данни\"}],[\"$\",\"div\",null,{\"style\":{\"fontSize\":15,\"color\":\"rgba(237,231,246,0.85)\"},\"children\":\"Не изискваме регистрация, имейл или парола. „Семейният код\\\" е случаен низ, който стои на твоето устройство; всеки с този код вижда съответната библиотека. Не продаваме данни. Името на детето и създадените истории никога не се изпращат към рекламни услуги.\"}]]}]\n11:[\"$\",\"section\",null,{\"id\":\"cookies\",\"style\":{\"marginBottom\":24},\"children\":[[\"$\",\"h2\",null,{\"style\":{\"fontSize\":18,\"fontWeight\":700,\"color\":\"#fff\",\"marginBottom\":6},\"children\":\"Бисквитки и реклама\"}],[\"$\",\"div\",null,{\"style\":{\"fontSize\":15,\"color\":\"rgba(237,231,246,0.85)\"},\"children\":\"На уебсайта питаме дали може да използваме бисквитки от Google (Google Analytics и Google Ads). Ако се съгласиш, те ни казват колко хора идват, от коя реклама и дали са опитали приказка или абонамент. Ако откажеш, нищо от това не се зарежда и сайтът работи по същия начин. Изборът се пази на устройството ти; за да го промениш, изтрий данните на сайта в браузъра и ще те попитаме отново. В приложенията от Google Play такива бисквитки не се използват. За да сравним вариантите на някои страници, броим посещенията по вариант чрез необратим отпечатък на IP адреса, без бисквитки и без да пазим самия адрес.\"}]]}]\n12:[\"$\",\"section\",null,{\"style\":{\"marginBottom\":24},\"children\":[[\"$\",\"h2\",null,{\"style\":{\"fontSize\":18,\"fontWeight\":700,\"color\":\"#fff\",\"marginBottom\":6},\"children\":\"Деца\"}],[\"$\",\"div\",null,{\"style\":{\"fontSize\":15,\"color\":\"rgba(237,231,246,0.85)\"},\"children\":\"Приложенията са предназначени за родители, които създават съдържание за децата си. Не искаме от децата лични данни. Въведеното име се използва единствено в текста на историята и може да е псевдоним.\"}]]}]\n13:[\"$\",\"section\",null,{\"style\":{\"marginBottom\":24},\"children\":[[\"$\",\"h2\",null,{\"style\":{\"fontSize\":18,\"fontWeight\":700,\"color\":\"#fff\",\"marginBottom\":6},\"children\":\"Доставчици, които обработват съдържание\"}],[\"$\",\"div\",null,{\"style\":{\"fontSize\":15,\"color\":\"rgba(237,231,246,0.85)\"},\"children\":\"За да генерираме историите използваме доставчици на изкуствен интелект и хостинг: Anthropic (текст), OpenAI и Google (илюстрации и глас), Supabase (съхранение), Vercel (хостинг). Изпратеният към тях текст е този, нужен за създаване на историята.\"}]]}]\n14:[\"$\",\"section\",null,{\"style\":{\"marginBottom\":24},\"children\":[[\"$\",\"h2\",null,{\"style\":{\"fontSize\":18,\"fontWeight\":700,\"color\":\"#fff\",\"marginBottom\":6},\"children\":\"Съхранение и изтриване\"}],[\"$\",\"div\",null,{\"style\":{\"fontSize\":15,\"color\":\"rgba(237,231,246,0.85)\"},\"children\":\"Създаденото се пази, докато не го изтриеш от устройството си или не поискаш изтриване. За да премахнеш облачно копие, пиши ни на посочения по-долу адрес с твоя семеен код.\"}]]}]\n15:[\"$\",\"section\",null,{\"style\":{\"marginBottom\":24},\"children\":[[\"$\",\"h2\",null,{\"style\":{\"fontSize\":18,\"fontWeight\":700,\"color\":\"#fff\",\"marginBottom\":6},\"children\":\"Твоите права\"}],[\"$\",\"div\",null,{\"style\":{\"fontSize\":15,\"color\":\"rgba(237,231,246,0.85)\"},\"children\":\"Имаш право на достъп, корекция и изтриване на данните си. Свържи се с нас за всяко такова искане.\"}]]}]\n16:[\"$\",\"section\",null,{\"style\":{\"marginBottom\":24},\"children\":[[\"$\",\"h2\",null,{\"style\":{\"fontSize\":18,\"fontWeight\":700,\"color\":\"#fff\",\"marginBottom\":6},\"children\":\"Контакт\"}],[\"$\",\"div\",null,{\"style\":{\"fontSize\":15,\"color\":\"rgba(237,231,246,0.85)\"},\"children\":[\"Въпроси относно поверителността: \",[\"$\",\"a\",null,{\"href\":\"mailto:privacy@aurakids.fun\",\"style\":{\"color\":\"#FFD93D\"},\"children\":\"privacy@aurakids.fun\"}]]}]]}]\n17:[\"$\",\"hr\",null,{\"style\":{\"border\":\"none\",\"borderTop\":\"1px solid rgba(255,255,255,0.12)\",\"margin\":\"40px 0\"}}]\n18:[\"$\",\"h2\",null,{\"style\":{\"fontSize\":22,\"fontWeight\":800,\"color\":\"#fff\",\"marginBottom\":8},\"children\":\"Privacy Policy (English)\"}]\n19:[\"$\",\"p\",null,{\"style\":{\"fontSize\":13,\"color\":\"rgba(237,231,246,0.6)\",\"marginBottom\":20},\"children\":\"Last updated: November 23, 2026\"}]\n1a:[\"$\",\"section\",null,{\"style\":{\"marginBottom\":24},\"children\":[[\"$\",\"h2\",null,{\"style\":{\"fontSize\":18,\"fontWeight\":700,\"color\":\"#fff\",\"marginBottom\":6},\"children\":\"Who we are\"}],[\"$\",\"div\",null,{\"style\":{\"fontSize\":15,\"color\":\"rgba(237,231,246,0.85)\"},\"children\":\"AuraKids creates personalised children's stories and comics. This policy covers the AuraKids Stories and AuraKids Comics apps and the aurakids.fun website.\"}]]}]\n1b:[\"$\",\"section\",null,{\"style\":{\"marginBottom\":24},\"children\":[[\"$\",\"h2\",null,{\"style\":{\"fontSize\":18,\"fontWeight\":700,\"color\":\"#fff\",\"marginBottom\":6},\"children\":\"What we collect\"}],[\"$\",\"div\",null,{\"style\":{\"fontSize\":15,\"color\":\"rgba(237,231,246,0.85)\"},\"children\":[\"$\",\"ul\",null,{\"style\":\"$d:0:1:d:r:props:children:0:props:children:4:props:children:1:props:children:props:style\",\"children\":[[\"$\",\"li\",null,{\"children\":[[\"$\",\"b\",null,{\"children\":\"What you enter\"}],\" to create a story: child's name, age range, chosen world/style and language — used only to generate the story or comic.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"b\",null,{\"children\":\"The content created\"}],\" (text, illustrations, voice) is stored so you can reopen it — locally and in a cloud copy tied to an anonymous \\\"family code\\\", with no email or account.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"b\",null,{\"children\":\"Technical data\"}],\": standard server logs and aggregate page counts with no personal data.\"]}]]}]}]]}]\n1c:[\"$\",\"section\",null,{\"style\":{\"marginBottom\":24},\"children\":[[\"$\",\"h2\",null,{\"style\":{\"fontSize\":18,\"fontWeight\":700,\"color\":\"#fff\",\"marginBottom\":6},\"children\":\"Cookies and advertising\"}],[\"$\",\"div\",null,{\"style\":{\"fontSize\":15,\"color\":\"rgba(237,231,246,0.85)\"},\"children\":\"On the website we ask whether we may use Google cookies (Google Analytics and Google Ads) to learn which ads bring visitors and whether they tried a story or a subscription. If you decline, none of it loads and the site works the same. The Google Play apps do not use these cookies. The child's name and stories are never sent to advertising services.\"}]]}]\n1d:[\"$\",\"section\",null,{\"style\":{\"marginBottom\":24},\"children\":[[\"$\",\"h2\",null,{\"style\":{\"fontSize\":18,\"fontWeight\":700,\"color\":\"#fff\",\"marginBottom\":6},\"children\":\"Children\"}],[\"$\",\"div\",null,{\"style\":{\"fontSize\":15,\"color\":\"rgba(237,231,246,0.85)\"},\"children\":\"The apps are for parents creating content for their children. We do not request personal data from children; the name entered is used only inside the story text and may be a nickname.\"}]]}]\n1e:[\"$\",\"section\",null,{\"style\":{\"marginBottom\":24},\"children\":[[\"$\",\"h2\",null,{\"style\":{\"fontSize\":18,\"fontWeight\":700,\"color\":\"#fff\",\"marginBottom\":6},\"children\":\"Processors\"}],[\"$\",\"div\",null,{\"style\":{\"fontSize\":15,\"color\":\"rgba(237,231,246,0.85)\"},\"children\":\"We use AI and hosting providers to generate stories: Anthropic (text), OpenAI and Google (images and voice), Supabase (storage), Vercel (hosting).\"}]]}]\n1f:[\"$\",\"section\",null,{\"style\":{\"marginBottom\":24},\"children\":[[\"$\",\"h2\",null,{\"style\":{\"fontSize\":18,\"fontWeight\":700,\"color\":\"#fff\",\"marginBottom\":6},\"children\":\"Your rights & contact\"}],[\"$\",\"div\",null,{\"style\":{\"fontSize\":15,\"color\":\"rgba(237,231,246,0.85)\"},\"children\":[\"You may access, correct or delete your data. Contact\",\" \",[\"$\",\"a\",null,{\"href\":\"mailto:privacy@aurakids.fun\",\"style\":{\"color\":\"#FFD93D\"},\"children\":\"privacy@aurakids.fun\"}],\".\"]}]]}]\n20:[\"$\",\"$L37\",null,{\"children\":[\"$\",\"$26\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@38\"}]}]\n27:[\"$\",\"meta\",\"15\",{\"property\":\"og:image:alt\",\"content\":\"AuraKids\"}]\n28:[\"$\",\"meta\",\"16\",{\"property\":\"og:type\",\"content\":\"website\"}]\n29:[\"$\",\"meta\",\"17\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}]\n2a:[\"$\",\"meta\",\"18\",{\"name\":\"twitter:title\",\"content\":\"Чуй приказка, в която героят е твоето дете | AuraKids\"}]\n2b:[\"$\",\"meta\",\"19\",{\"name\":\"twitter:description\",\"content\":\"Вечерна приказка с името на детето ти, с уникални илюстрации и глас, готова за минута. Опитай безп